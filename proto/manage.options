# nanopb limits for the device. sidp-agent enforces the same limits.
si.manage.DeviceInfo.serial             max_size:32
si.manage.DeviceInfo.firmware_version   max_size:32
si.manage.DeviceInfo.js_version         max_size:16
si.manage.DeviceInfo.firmware_commit    max_size:16
si.manage.DeviceInfo.hardware           max_size:16
si.manage.AssetBeginRequest.name        max_size:32
si.manage.AssetBeginRequest.sha256      max_size:32 fixed_length:true
si.manage.JobSetRequest.sha256          max_size:32 fixed_length:true
si.manage.JobStatus.name                max_size:32
si.manage.JobStatus.sha256              max_size:32 fixed_length:true
si.manage.RunRecord.job_name            max_size:32
si.manage.RunRecord.job_sha256          max_size:32 fixed_length:true
si.manage.RunRecord.script_sha256       max_size:32
si.manage.RunRecord.results_json        max_size:360
si.manage.LogEntry.record               max_size:512
si.manage.NetConfig.wifi_ssid           max_size:33
si.manage.NetConfig.wifi_password       max_size:65
si.manage.NetConfig.server_url          max_size:128
si.manage.NetConfig.password_salt       max_size:32
si.manage.NetConfig.password_verifier   max_size:384
si.manage.NetStatus.ip                  max_size:16
si.manage.NetStatus.device_id           max_size:13
